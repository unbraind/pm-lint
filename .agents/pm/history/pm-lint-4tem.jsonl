{"hash_algorithm":"sha256","ts":"2026-10-28T15:21:21.086Z","author":"claude-hub","author_source":"asserted","agent_harness":"claude-code","agent_model":"claude-opus-5-5","agent_model_source":"probe","agent_instance":"b72b4ad539c4794f7abb86ea","agent_provenance":{"model":{"value":"claude-opus-5-5","source":"probe"},"effort":{"value":"xhigh","source":"environment"},"role":null,"topic":null,"version":{"value":"2.1.312","source":"probe"}},"op":"comment_add","patch":[{"op":"replace","path":"/metadata/updated_at","value":"2026-10-28T15:21:21.086Z"},{"op":"add","path":"/metadata/comments","value":[{"created_at":"2026-10-28T15:21:21.086Z","author":"claude-hub","text":"Evidence: the failed release job log shows 'npm error command git --no-replace-objects ls-remote ssh://git@github.com/release-artifact/package.tgz.git' and 'git@github.com: Permission denied (publickey)' on each of the 3 attempts (same failure in pm-evidence, pm-hypothesis, pm-jev, pm-lint, pm-memory, pm-review, pm-rlm and pm-swarm, which all carry the scaffold line). The other uses of release-artifact/package.tgz in release.yml are shell arguments (mv, sha256sum, openssl), not npm package specs. Fleet tracking: unbraind/pm-cli-companion item pm-cli-website-l9y4."}]}],"before_hash":"fbcba0f4278d4479192a71784fccf95a5df55c1c1df761996d2e8d0a77fc0962","after_hash":"06a3fc112353c848487816c361572c63778df00e41ad4c12e54ee28173140953","item_hash_version":3,"context":{"agent_provenance_outcomes":{"model":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"},"version":{"status":"resolved","resolver":"claude_session_file","rule_version":"v1"}}},"event_class":"substantive","record_hash_version":1,"record_hash":"294ff8ac00077cfe3bf7a03f4b9440f41612c66b8d75da62228db8865cbd9e34"}
