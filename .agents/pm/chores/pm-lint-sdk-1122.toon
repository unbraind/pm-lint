tests[2]{command,scope,timeout_seconds,provenance{author,created_at,source_kind,source_ref}}:
  node --test --test-concurrency=1 test/incremental.test.ts test/witnesses.test.ts test/package-metadata.test.ts,project,600,codex-agent,"2026-11-24T04:00:42.224Z",local_mutation,deps/adopt-pm-cli-host-alignment-1122
  "node --test --test-concurrency=1 --test-name-pattern \"every asynchronous preview boundary\" test/repairs.test.ts",project,600,codex-agent,"2026-11-24T04:10:22.682Z",local_mutation,deps/adopt-pm-cli-host-alignment-1122
